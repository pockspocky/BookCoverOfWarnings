# API process. Copy to server/.env for local runs outside Compose.
# Never commit secrets. Do not put real student records in this file.

# Secrets resolve from NAME_FILE, then a file named NAME inside SECRETS_DIR, then NAME.
# In production, placeholder values such as "bow" and "bowsecret" are rejected.
DATABASE_URL=postgres://bow:replace-with-secret@127.0.0.1:5433/bow
PORT=3001
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
SCHOOL_EMAIL_DOMAIN=waprep.org

# httpOnly session cookie. Use true behind HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Sliding windows. Exceeding either limit returns 429 and Retry-After.
SUBMISSION_RATE_LIMIT=30
SUBMISSION_RATE_WINDOW_SECONDS=3600
SEARCH_RATE_LIMIT=60
SEARCH_RATE_WINDOW_SECONDS=60

MAX_UPLOAD_BYTES=10000000
ALLOWED_UPLOAD_TYPES=application/pdf,image/png,image/jpeg,text/plain

# MinIO / S3-compatible attachment storage. Bytes are not written into Postgres or search.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=bow-attachments
S3_ACCESS_KEY=bow
S3_SECRET_KEY=replace-with-secret
S3_FORCE_PATH_STYLE=true

# Local password login remains available for the bootstrapped administrator.
# Institutional login uses the authorization code flow with PKCE when these values are set.
# Leave IDENTITY_PROVIDER=unconfigured until the issuer, client id, and client secret exist.
# Put OIDC_CLIENT_SECRET in OIDC_CLIENT_SECRET_FILE or SECRETS_DIR, not in the client bundle.
IDENTITY_PROVIDER=unconfigured
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/oidc/callback

# Vercel does not read this file or secrets/. Set variables in the project instead.
# DATABASE_URL must be Neon's pooled URL (the hostname contains -pooler).
# Leave WEB_ORIGIN and API_PUBLIC_URL unset to use https://$VERCEL_URL.
# COOKIE_SECURE defaults to true when VERCEL is set.
# Leave S3_ENDPOINT and IDENTITY_PROVIDER unset. Attachments and institutional login stay off.
# SCHOOL_EMAIL_DOMAIN=waprep.org
# NODE_ENV=production

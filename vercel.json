{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nuxtjs"
    },
    "server": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "server/Dockerfile",
      "devCommand": "npm run dev --prefix server"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}

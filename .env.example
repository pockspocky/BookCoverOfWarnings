# Frontend runtime configuration
# Copy to .env and adjust. Never commit secrets.

# Origin of the Book Of Warnings API. The Nuxt app only talks to this URL.
# Local default is the API process on port 3001.
# On Vercel, leave this unset or empty so the browser calls same-origin /api.
# The value is compiled into the client. Do not put secrets here.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Client-side school-email format check. This is not proof of identity.
# The API enforces the same domain from SCHOOL_EMAIL_DOMAIN.
# School account sign-in redirects to the API. The browser session is an httpOnly cookie, not a script-readable token.
NUXT_PUBLIC_SCHOOL_EMAIL_DOMAIN=waprep.org

# Operator note. The frontend does not connect to an identity provider.
# Roster mapping is imported into the API database. Do not infer it from display names.
NUXT_PUBLIC_IDENTITY_MAPPING_SOURCE=unconfigured

# Vercel uses the directory that contains this file as the image context.
# That context is the repository root, so the image can copy both server/ and lib/.
FROM node:22-bookworm-slim
WORKDIR /app

COPY server/package.json server/package-lock.json ./server/
WORKDIR /app/server
RUN npm ci

WORKDIR /app
COPY lib ./lib
COPY server ./server
WORKDIR /app/server

ENV NODE_ENV=production
ENV NODE_PATH=/app/server/node_modules
ENV PORT=3001
EXPOSE 3001
CMD ["npx", "tsx", "src/index.ts"]
